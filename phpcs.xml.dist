<?xml version="1.0"?>
<ruleset name="Televixo">
	<file>televixo</file>
	<exclude-pattern>televixo/assets/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.7"/>
	<rule ref="PHPCompatibilityWP"/>
	<!-- PHPCompatibility does not model enums: `match ($this)` inside an enum method is valid PHP 8.1+. -->
	<rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts"><exclude-pattern>*/Domain/ConversationStatus.php</exclude-pattern></rule>
	<rule ref="PHPCompatibility.FunctionDeclarations.NewParamTypeDeclarations"><exclude-pattern>*/Domain/ConversationStatus.php</exclude-pattern></rule>
	<rule ref="WordPress.Security">
		<!-- Exception messages are returned as JSON by REST handlers (WP_Error),
		     never echoed into HTML; HTML output paths escape explicitly. -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="televixo"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="televixo"/><element value="Televixo"/></property></properties>
	</rule>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>
	<rule ref="Generic.PHP.BacktickOperator"/>
	<rule ref="Squiz.PHP.Eval"/>
</ruleset>
