    "test:js": "node --test tests/js/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "package": "node bin/package.mjs"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@types/react": "18.3.12",
    "@wordpress/api-fetch": "7.20.0",
    "@wordpress/element": "6.20.0",
    "@wordpress/i18n": "5.20.0",
    "axe-core": "4.10.3",
    "esbuild": "0.25.12",
    "typescript": "5.8.3"
  }
}