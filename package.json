{
  "name": "televixo",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for Televixo \u2013 Telegram Live Chat for WordPress",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node bin/build.mjs",
    "build:dev": "node bin/build.mjs --dev",
